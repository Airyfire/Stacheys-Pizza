# Stripe API Keys (Test Mode)
# Get yours at: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_KEY
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_KEY

# Admin password hash (bcrypt). Generate with:
#   node -e "console.log(require('bcrypt').hashSync('yourPassword', 12))"
ADMIN_PASSWORD_HASH=

# Allowed origins for CORS (comma‑separated). Adjust for production.
ALLOWED_ORIGINS=http://localhost:3001
